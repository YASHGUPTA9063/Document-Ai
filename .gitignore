# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
Desktop.ini

# Folder config file
Desktop.ini

# Mac OS X folder settings
.DS_Store

# IDE and local editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# Environments
*.db

# Document storage (uploaded files — never commit real document data)
storage/

# Test / scratch files (fix #5 — prevent dev leftovers from being committed)
test.*
test_*.*
fake*.*
scratch.*
# ...but the real test suites live in backend-v2/tests/ and must be committed.
# Without this negation, `test_*.*` above silently drops every NEW test file;
# the existing ones only survive because they were already tracked.
!backend-v2/tests/
!backend-v2/tests/*.py

# Log and debug output files
*.log
*.txt
# Negation must not be commented out — a leading '#' makes it a comment, which
# left requirements.txt matched by *.txt above.
!requirements.txt

# Agent customizations (skills, rules — local dev config only)
.agents/
backend-v2/venv
backend-v2/doc_workflow.db-shm
backend-v2/doc_workflow.db-wal
# Written by deploy-azure.sh on the VM (compose variable substitution:
# ports, generated Postgres password). Host-specific — never commit it.
/.env

# TLS keys, the private CA and Let's Encrypt state from setup-https.sh.
/certs/
