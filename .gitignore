# Runtime logs and debug dumps
*.log
app_logs.txt
ocr_debug.txt
config_code.txt

# OCR output dumps — may contain real document/PII data, never commit
output.json
backend-v2/output.json

# Document storage (uploaded files — never commit real document data)
storage/

# Test / scratch files (fix #5 — prevent dev leftovers from being committed)
test.*
test_*.*
fake*.*
scratch.*

# Agent customizations (skills, rules — local dev config only)
.agents/
backend-v2/venv