MISTRAL_API_KEY=your_mistral_api_key_here
STORAGE_DIR=./storage
DATABASE_URL=sqlite+aiosqlite:///./doc_workflow.db
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Sampling temperature for all Mistral agents and chat completions (0.0 - 1.0)
# Applied to agent completion_args in agents_config.py and every direct chat.complete call.
# Lower = more deterministic. Set to 0 for fully deterministic extraction.
LLM_TEMPERATURE=0.1

# Max output tokens for all Mistral agents and chat completions.
# Applied to agent completion_args in agents_config.py and every direct chat.complete call.
LLM_MAX_TOKENS=20480

# Extraction pipeline mode:
#   two_step  = OCR (mistral-ocr-4-1) then separate mistral-large-latest call for
#               structured field extraction. Higher accuracy, 2 API calls. (default)
#   ocr_only  = Single OCR call with built-in document annotation. Faster, cheaper,
#               1 API call. Falls back to two_step for DOCX files automatically.
EXTRACTION_MODE=two_step

# Agent IDs — copy from Mistral AI Studio after creating each agent
CLASSIFIER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Extractor Agent ID — create one general agent in Mistral AI Studio
# It should be configured with the appropriate system prompt and extraction schema
GENERAL_EXTRACTOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VALIDATOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REVIEWER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AUTO_VERIFIER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OUTPUT_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Signature Verification Agent IDs
SIGNATURE_VISION_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SIGNATURE_JUDGE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Face Verification Agent IDs (run python create_face_agents.py to generate)
FACE_MORPHOLOGY1_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FACE_MORPHOLOGY2_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FACE_AGE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FACE_JUDGE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Pre-Validation Vision Agent (create in Mistral Studio with vision model, paste ID here)
PRE_VALIDATOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Intake Agent (create in Mistral Studio, paste ID here)
INTAKE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Preprocessing Agent (create in Mistral Studio, paste ID here)
PREPROCESSING_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Fraud Examiner Agent (create in Mistral Studio, paste ID here)
FRAUD_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Document Boundary Splitter Agent (create in Mistral Studio, paste ID here)
SPLITTER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Document Checklist Agent (create in Mistral Studio, paste ID here)
# Optional — with no ID the checklist still runs and uses a deterministic summary.
CHECKLIST_AGENT_ID=

# Claim Processing Agent IDs
# Create each agent in Mistral Studio using the instructions in agents_config.py
# Run: python agents_config.py — for a quick reference list
CLAIM_INTEGRITY_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLAIM_MEDICAL_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLAIM_TREATMENT_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLAIM_DISABILITY_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLAIM_LITIGATION_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLAIM_REPORT_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx




# Preprocessing Step (Step 2.5)
# Set ENABLE_PREPROCESSING=true to activate skew correction, brightness/CLAHE, noise removal, resolution normalization
# Applies to image files (.jpg, .png, .webp). DOCX is always skipped.
ENABLE_PREPROCESSING=false
# Set ENABLE_PREPROCESSING_PDF=true to also preprocess PDF files (rasterizes each page at 150 DPI, then reassembles)
# Only has effect when ENABLE_PREPROCESSING=true
ENABLE_PREPROCESSING_PDF=false

# ─── Document Splitting (Step 1.5) ───
# Detects an upload that holds several stitched-together documents, cuts it into one
# PDF per document, and runs the pipeline on each separately. Every child reuses the
# classification produced during the split, so nothing is classified twice.
# The only switch for this stage — there is no UI toggle, exactly as with
# ENABLE_DOC_CHECKLIST below. Settings -> Document Splitting tunes how it
# behaves (storage/splitting_config.json) but cannot turn it on or off.
# With this off, Step 1.5 never runs and the stage is hidden everywhere in the UI:
# no "Packet Split" pipeline step, no splitter agent card, no auto-split toggle on
# Upload, and no Settings -> Document Splitting section.
ENABLE_DOC_SPLITTING=false
# Pages below this confidence send the boundaries to human review, and make the child
# re-run classification instead of reusing the split result.
SPLIT_CONFIDENCE_THRESHOLD=0.75
# Pages classified per agent call. Higher is cheaper and faster.
SPLIT_PAGE_BATCH_SIZE=8
# Files longer than this are processed whole rather than split.
SPLIT_MAX_PAGES=50
# Pause for human confirmation when any page is below the threshold.
SPLIT_REQUIRE_REVIEW=true
# Absorb a low-confidence single-page outlier back into the document around it.
SPLIT_MERGE_ORPHANS=true

# ─── Batch Checklist (Step 3.2) ───
# After each document classifies, reconciles the doc types seen across the whole
# upload batch against the configured classification types (Settings ->
# Classification Types) and pauses the batch when a type was never uploaded.
# With this off, Step 3.2 never runs and the "Checklist" pipeline step and checklist
# agent card are hidden.
ENABLE_DOC_CHECKLIST=true
# Pause for human confirmation when required types are missing. With this off the
# gap is logged and the pipeline continues.
CHECKLIST_REQUIRE_REVIEW=true

# Google Document AI Settings
GOOGLE_APPLICATION_CREDENTIALS=
DOCUMENTAI_PROJECT_ID=458272416814
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=ae6356d350bf69a6

