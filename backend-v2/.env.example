MISTRAL_API_KEY=your_mistral_api_key_here
STORAGE_DIR=./storage
DATABASE_URL=sqlite+aiosqlite:///./doc_workflow.db
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Agent IDs — copy from Mistral AI Studio after creating each agent
CLASSIFIER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Extractor Agent IDs — create one agent per doc type in Mistral AI Studio
# Each agent should be configured with the appropriate system prompt and extraction schema
INVOICE_EXTRACTOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CONTRACT_EXTRACTOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KYC_EXTRACTOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MEDICAL_EXTRACTOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BANK_EXTRACTOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VALIDATOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REVIEWER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AUTO_VERIFIER_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OUTPUT_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Signature Verification Agent IDs
SIGNATURE_VISION_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SIGNATURE_JUDGE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Face Verification Agent IDs (run python create_face_agents.py to generate)
FACE_MORPHOLOGY1_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FACE_MORPHOLOGY2_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FACE_AGE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FACE_JUDGE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Pre-Validation Vision Agent (create in Mistral Studio with vision model, paste ID here)
PRE_VALIDATOR_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Intake Agent (create in Mistral Studio, paste ID here)
INTAKE_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Preprocessing Agent (create in Mistral Studio, paste ID here)
PREPROCESSING_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Fraud Examiner Agent (create in Mistral Studio, paste ID here)
FRAUD_AGENT_ID=ag:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx




# Preprocessing Step (Step 2.5)
# Set ENABLE_PREPROCESSING=true to activate skew correction, brightness/CLAHE, noise removal, resolution normalization
# Applies to image files (.jpg, .png, .webp). DOCX is always skipped.
ENABLE_PREPROCESSING=false
# Set ENABLE_PREPROCESSING_PDF=true to also preprocess PDF files (rasterizes each page at 150 DPI, then reassembles)
# Only has effect when ENABLE_PREPROCESSING=true
ENABLE_PREPROCESSING_PDF=false

# Google Document AI Settings
GOOGLE_APPLICATION_CREDENTIALS=
DOCUMENTAI_PROJECT_ID=458272416814
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=ae6356d350bf69a6

