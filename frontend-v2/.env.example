# Base URL the axios client points at (src/api/client.js).
# Must include the /api/v1 prefix — that is where the backend mounts its router
# (see backend-v2/api/routers/v1/__init__.py).
#
# Running Vite directly against a local backend:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Under docker compose the nginx sidecar proxies /api/ to the app service, so
# the Dockerfile passes a relative path instead: VITE_API_BASE_URL=/api/v1
