# Relative path — proxied to the backend by nginx (Docker) or the Vite dev
# server (npm run dev). Set an absolute URL only to target a remote backend.
#
# /api/v1 is the canonical, versioned backend surface. The unprefixed paths the
# older build used (/upload, /status/{id}) are still served while the backend's
# ENABLE_LEGACY_ROOT_ROUTES is on, but nothing here should rely on them.
VITE_API_BASE_URL=/api/v1
